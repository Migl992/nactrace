{
  "name": "nactrace-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "NAC (cross-interface call) debugger for Etherlink / Tezos X",
  "license": "MIT",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b packages/core packages/cli packages/hooks packages/widget"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^1.8.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  }
}
