{
  "name": "nactrace-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "NAC (cross-interface call) debugger for Etherlink / Tezos X",
  "license": "MIT",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20.16"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm --filter @nactrace/core build && pnpm -r run typecheck",
    "fixtures:record": "pnpm --filter @nactrace/core build && node scripts/record-fixtures.mjs && node scripts/gen-xtzkt-types.mjs",
    "previewnet:setup": "node --env-file=.env scripts/previewnet/01-originate-counter.mjs && node --env-file=.env scripts/previewnet/02-deploy-and-call-evm.mjs && node --env-file=.env scripts/previewnet/03-call-evm-from-michelson.mjs",
    "types:xtzkt": "node scripts/gen-xtzkt-types.mjs",
    "nightly": "node scripts/nightly.mjs --report nightly-report.md",
    "e2e:live": "node scripts/e2e-live.mjs",
    "e2e:browser": "node scripts/e2e-browser.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^1.8.0",
    "@taquito/local-forging": "^25.0.0",
    "@taquito/signer": "^25.0.0",
    "@taquito/taquito": "^25.0.0",
    "@taquito/utils": "^25.0.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "happy-dom": "^20.14.5",
    "playwright": "1.56.1",
    "prettier": "^3.4.0",
    "solc": "^0.8.37",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "viem": "^2.56.9",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Migl992/nactrace.git"
  },
  "homepage": "https://github.com/Migl992/nactrace#readme",
  "bugs": {
    "url": "https://github.com/Migl992/nactrace/issues"
  },
  "author": "mig"
}
