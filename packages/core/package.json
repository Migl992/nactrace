{
  "name": "@nactrace/core",
  "version": "0.0.0",
  "description": "NAC (cross-interface call) tracing and explanation for Etherlink / Tezos X",
  "license": "MIT",
  "author": "mig",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
