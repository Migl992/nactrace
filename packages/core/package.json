{
  "name": "@nactrace/core",
  "version": "1.0.1",
  "description": "NAC (cross-interface call) tracing and explanation for Etherlink / Tezos X",
  "license": "MIT",
  "author": "mig",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/node.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "^1.6.0",
    "viem": "^2.21.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Migl992/nectrace.git"
  },
  "homepage": "https://github.com/Migl992/nectrace#readme",
  "bugs": {
    "url": "https://github.com/Migl992/nectrace/issues"
  },
  "keywords": [
    "tezos",
    "etherlink",
    "tezos-x",
    "nac",
    "cross-runtime",
    "michelson",
    "evm",
    "debugger",
    "trace"
  ],
  "engines": {
    "node": ">=20.16"
  },
  "publishConfig": {
    "access": "public"
  }
}
