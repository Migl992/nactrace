{
  "name": "@nactrace/hooks",
  "version": "1.0.0",
  "description": "Hardhat task nactrace:last and the nactrace-foundry script; thin wrappers around the nactrace CLI",
  "license": "MIT",
  "author": "mig",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/foundry.ts src/hardhat.ts src/hardhat-action.ts src/shim.ts --format esm --dts --clean --external hardhat && node -e \"require('fs').copyFileSync('src/hardhat2.cjs','dist/hardhat2.cjs')\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nactrace/core": "workspace:^",
    "nactrace": "workspace:^"
  },
  "bin": {
    "nactrace-foundry": "./dist/foundry.js",
    "nactrace-etherlink-shim": "./dist/shim.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hardhat": {
      "types": "./dist/hardhat.d.ts",
      "import": "./dist/hardhat.js"
    },
    "./hardhat2": "./dist/hardhat2.cjs"
  },
  "peerDependencies": {
    "hardhat": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "hardhat": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Migl992/nactrace.git"
  },
  "homepage": "https://github.com/Migl992/nactrace#readme",
  "bugs": {
    "url": "https://github.com/Migl992/nactrace/issues"
  },
  "keywords": [
    "tezos",
    "etherlink",
    "tezos-x",
    "nac",
    "cross-runtime",
    "michelson",
    "evm",
    "debugger",
    "trace"
  ],
  "engines": {
    "node": ">=20.16"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "hardhat": "^3.18.0"
  }
}
