{
  "name": "@nactrace/widget",
  "version": "0.1.0",
  "description": "Embeddable nactrace.js: one script tag renders the timeline and explanation of a cross-interface call on Etherlink / Tezos X",
  "license": "MIT",
  "author": "mig",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nactrace/core": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Migl992/nectrace.git"
  },
  "homepage": "https://github.com/Migl992/nectrace#readme",
  "bugs": {
    "url": "https://github.com/Migl992/nectrace/issues"
  },
  "keywords": [
    "tezos",
    "etherlink",
    "tezos-x",
    "nac",
    "cross-runtime",
    "michelson",
    "evm",
    "debugger",
    "trace"
  ],
  "engines": {
    "node": ">=20.16"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/nactrace.js",
  "unpkg": "./dist/nactrace.js",
  "jsdelivr": "./dist/nactrace.js",
  "exports": {
    ".": "./dist/nactrace.js"
  }
}
